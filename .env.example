LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Supabase。SUPABASE_SERVICE_KEY 必須是 service_role 金鑰（Supabase → Settings → API），
# 不能用 anon / publishable 金鑰：圖片存檔會被 storage 的 RLS 擋掉。
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Gemini（分類、圖片辨識、摘要、問答都用這把）
GEMINI_API_KEY=
# 可選，不設就用 gemini-3.1-flash-lite
GEMINI_MODEL=

# 後台密碼
DASHBOARD_TOKEN=

# 可選：圖片存檔設定
# IMAGE_BUCKET=note-images
# IMAGE_URL_TTL=3600
# STORE_IMAGE_TTL_MIN=5
