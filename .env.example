# ── 必填 ─────────────────────────────────────────────
# 詳細申請步驟見 README.md。部署後打開 /setup.html，設定精靈會逐項檢查。

# LINE Developers → 你的 Channel → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers → 你的 Channel → Messaging API → Channel access token（按 Issue）
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# 必須是 service_role 金鑰（Supabase → Project Settings → API Keys），
# 不能用 anon / publishable 金鑰：圖片存檔會被 storage 的 RLS 擋掉。
SUPABASE_SERVICE_KEY=

# Google AI Studio → Get API key（分類、圖片辨識、摘要、問答、讀服事表 PDF 都用這把）
GEMINI_API_KEY=

# 後台密碼，自己取一組
DASHBOARD_TOKEN=

# 你的 LINE userId。部署好之後先留空，傳任何一句話給小秘書，它會回你這串，再填進來 Redeploy。
# 設定之後小秘書只回應你一個人。
LINE_USER_ID=

# ── 建議 ─────────────────────────────────────────────
# 保護提醒排程網址（/api/cron/remind?token=這串），隨便取一組亂碼
CRON_SECRET=

# ── 選填 ─────────────────────────────────────────────
# 你在服事表上的名字：查「我的服事」，以及服事前一晚提醒
# WORSHIP_MY_NAME=
# 服事前一晚幾點提醒（預設 20，晚上 8 點）
# WORSHIP_EVE_HOUR=20
# 行事曆訂閱（/calendar.ics?token=這串）
# CALENDAR_TOKEN=
# 在「專案」指令裡顯示 GitHub 本週動態
# GITHUB_TOKEN=
# 換 AI 模型（不設就用預設）
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_PDF_MODEL=gemini-3.6-flash
# 提醒提前幾分鐘發（預設 5）
# REMIND_LEAD_MINUTES=5
# 圖片存檔設定
# IMAGE_BUCKET=note-images
# IMAGE_URL_TTL=3600
# STORE_IMAGE_TTL_MIN=5
